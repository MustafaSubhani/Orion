# Copy to .env and fill in. Never commit real keys.

# --- hosted (current paper cells) ---
# MISTRAL_API_KEY=
# ORION_WORKER_MODEL=open-mistral-nemo
# ORION_ROUTER_MODEL=ministral-8b-latest
# ORION_JUDGE_MODEL=mistral-large-latest
# ORION_JUDGE_PROVIDER=mistral

# --- local OpenAI-compatible (Ollama / vLLM / LM Studio) ---
# Point the same harness at a local server. No worker file edits.
# ORION_WORKER_PROVIDER=openai_compat
# ORION_ROUTER_PROVIDER=openai_compat
# ORION_JUDGE_PROVIDER=openai_compat
# ORION_WORKER_BASE_URL=http://127.0.0.1:11434/v1
# ORION_WORKER_API_KEY=local
# ORION_WORKER_MODEL=llama3.1
# ORION_ROUTER_MODEL=llama3.1
# ORION_JUDGE_MODEL=llama3.1
# ORION_CONTEXT_WINDOW=8192
# ORION_LLM_TIMEOUT=180
# ORION_MAX_TOKENS=16000

# LM Studio default: http://127.0.0.1:1234/v1
# vLLM default:      http://127.0.0.1:8000/v1

# --- product control plane ---
# ORION_API_KEY=          # if set, /chat /ingest /mcp /traces require Authorization: Bearer
# ORION_ADMIN_PASSWORD=admin
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- OpenAI (hosted worker, and hosted web search) ---
# OPENAI_API_KEY=
# ORION_WORKER_PROVIDER=openai
# ORION_OPENAI_BASE_URL=             # Azure / proxy; empty means api.openai.com

# --- security and tenancy ---
# ORION_ENV=production               # refuses to start without ORION_ADMIN_PASSWORD
# ORION_AUTH_REQUIRED=true           # false only for single-user local use
# ORION_SESSION_TTL=43200            # seconds
# ORION_CORS_ORIGINS=http://localhost:3000
# ORION_STATE_DB=                    # settings, approvals, threads (default: orion_state.db)
# ORION_AUTH_DB=                     # users and sessions

# --- runtime ---
# ORION_PARALLEL_WORKERS=4
# ORION_NODE_TIMEOUT=0               # seconds per agent node, 0 = none

# --- connectors and MCP (JSON paths or inline JSON) ---
# ORION_CONNECTORS=config/connectors.json
# ORION_MCP_SERVERS=config/mcp_servers.json

# --- trace hygiene ---
# ORION_TRACE_SCRUB=1                # mask emails, phones, tokens on disk
# ORION_TRACE_MAX_MB=50              # audit log rotation
# ORION_TRACE_RETENTION_DAYS=30

# --- optional SSO (pip install "orion-harness[oidc]") ---
# ORION_OIDC_ISSUER=https://idp.example.com
# ORION_OIDC_CLIENT_ID=orion
# ORION_OIDC_JWKS_URL=               # empty: discovered from the issuer
# ORION_OIDC_TENANT_CLAIM=tenant     # a missing claim means ORION_OIDC_DEFAULT_TENANT
# ORION_OIDC_ROLE_CLAIM=roles
# ORION_OIDC_ADMIN_VALUES=orion-admin
# ORION_OIDC_USERNAME_CLAIM=preferred_username
# ORION_OIDC_AUTO_PROVISION=true

# Any setting (see README, Settings) can be set as ORION_<KEY>, e.g. ORION_GUARD_ENABLED=true
