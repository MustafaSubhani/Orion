# Copy to .env and fill in. Never commit real keys.

# --- hosted (current paper cells) ---
# MISTRAL_API_KEY=
# ORION_WORKER_MODEL=open-mistral-nemo
# ORION_ROUTER_MODEL=ministral-8b-latest
# ORION_JUDGE_MODEL=mistral-large-latest
# ORION_JUDGE_PROVIDER=mistral

# --- local OpenAI-compatible (Ollama / vLLM / LM Studio) ---
# Point the same harness at a local server. No worker file edits.
# ORION_WORKER_PROVIDER=openai_compat
# ORION_ROUTER_PROVIDER=openai_compat
# ORION_JUDGE_PROVIDER=openai_compat
# ORION_WORKER_BASE_URL=http://127.0.0.1:11434/v1
# ORION_WORKER_API_KEY=local
# ORION_WORKER_MODEL=llama3.1
# ORION_ROUTER_MODEL=llama3.1
# ORION_JUDGE_MODEL=llama3.1
# ORION_CONTEXT_WINDOW=8192
# ORION_LLM_TIMEOUT=180
# ORION_MAX_TOKENS=16000

# LM Studio default: http://127.0.0.1:1234/v1
# vLLM default:      http://127.0.0.1:8000/v1

# --- product control plane ---
# ORION_API_KEY=          # if set, /chat /ingest /mcp /traces require Authorization: Bearer
# ORION_ADMIN_PASSWORD=admin
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

